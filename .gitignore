cat << 'EOF' > .gitignore

# Dependencies
node_modules/
.pnp/
.pnp.js

# Next.js
.next/
out/
build/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing
coverage/

# Cache
.cache/
.eslintcache

# Production builds
dist/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp

EOF